# The development stack. Brought up by `./run.sh env`, which passes --wait so that
# nothing starts talking to a service before its healthcheck has passed.
#
# Every service declares a healthcheck for exactly that reason: without one,
# compose reports a container as up the moment the process starts, and the
# application then fails on a connection or a discovery call that would have
# succeeded a second later.

name: {{.ContainerPrefix}}

services:
{{- if .Database}}
  postgres:
    image: postgres:18-alpine
    container_name: {{.ContainerPrefix}}-postgres
    environment:
      POSTGRES_DB: {{.DatabaseName}}
      POSTGRES_USER: {{.DatabaseName}}
      POSTGRES_PASSWORD: dev
    ports:
      # The host side is this project's own, so another project's stack can be up
      # at the same time. application.properties points at the same number.
      - "{{.DatabasePort}}:5432"
    volumes:
      # The image's data root, not the `data` directory under it that older images
      # used: from 18 the data lives in a major-version subdirectory here, and a
      # volume on the old path is what makes the container refuse to start.
      - postgres-data:/var/lib/postgresql
    healthcheck:
      # -U and -d rather than a bare pg_isready: during initialisation the server
      # accepts connections on the postgres database before the project's own
      # exists, so the bare form reports healthy too early.
      test: ["CMD-SHELL", "pg_isready -U {{.DatabaseName}} -d {{.DatabaseName}}"]
      interval: 5s
      timeout: 5s
      retries: 10
{{- end}}
{{- if .Auth}}

  keycloak:
    image: quay.io/keycloak/keycloak:26.0
    container_name: {{.ContainerPrefix}}-keycloak
    # start-dev, not start: this is an in-memory development instance with no
    # hostname or TLS configured, and production mode refuses to start without them.
    command: ["start-dev", "--import-realm", "--health-enabled=true"]
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: admin
    ports:
      # A port of this project's own, and not the application's: the browser has
      # to reach both, since the login redirect goes out to Keycloak and back.
      # The management port stays inside the container — only the healthcheck
      # below talks to it, and publishing it would be one more port to collide on.
      - "{{.AuthPort}}:8080"
    volumes:
      - ./keycloak:/opt/keycloak/data/import:ro
    healthcheck:
      # The image carries no curl or wget, so the check goes through the JVM that
      # is already in it. Keycloak serves its health endpoints on the management
      # port, 9000, not on 8080.
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/localhost/9000 && echo -e 'GET /health/ready HTTP/1.1\\nHost: localhost\\nConnection: close\\n\\n' >&3 && cat <&3 | grep -q '\"status\": \"UP\"'"]
      interval: 5s
      timeout: 5s
      retries: 20
{{- end}}
{{- if .Database}}

volumes:
  postgres-data:
    # Named after the stack so that `./run.sh env reset` can find every volume it
    # owns by prefix, without this file having to list them anywhere else.
    name: {{.ContainerPrefix}}-postgres-data
{{- end}}
