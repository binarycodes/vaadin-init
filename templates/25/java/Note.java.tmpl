package {{.Package}}.notes;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Table;

import java.time.Instant;

/**
 * A note.
 *
 * <p>Not a record: JPA has to be able to instantiate this without arguments and
 * then set the fields, which a record cannot offer. The no-argument constructor
 * is protected for the same reason — it exists for Hibernate, and application
 * code that wants a Note has to say what it says.
 *
 * <p>The columns are declared here and created by
 * {@code src/main/resources/db/migration}. Flyway owns the schema and Hibernate
 * only validates against it, so a field added here without a migration is a
 * start-up failure rather than a silent schema change.
 */
@Entity
@Table(name = "note")
public class Note {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(name = "body", nullable = false)
    private String body;

    @Column(name = "created_at", nullable = false)
    private Instant createdAt;

    protected Note() {
    }

    public Note(String body) {
        this.body = body;
        this.createdAt = Instant.now();
    }

    public Long getId() {
        return id;
    }

    public String getBody() {
        return body;
    }

    public Instant getCreatedAt() {
        return createdAt;
    }
}
